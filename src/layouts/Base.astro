---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Amplify — youth music community',
  description = 'A youth movement bringing young people together through music. You don’t have to be the best to belong.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/assets/logos/amplify-icon-mark-trim.png" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
