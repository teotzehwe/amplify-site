---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('events', (e) => e.data.published !== false))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<Base title="upcoming jams" description="Upcoming AmplifyForYouth jams — free, open music events for young people in Singapore. Show up, bring a friend, no experience needed.">
  <main>
    <section style="width:100%; max-width:var(--container-max); margin-inline:auto; padding-inline:var(--space-5); padding-top:var(--space-8); padding-bottom:var(--space-6);">
      <span style="display:inline-flex; align-items:center; gap:8px; font-family:var(--font-display); text-transform:uppercase; letter-spacing:0.08em; font-size:var(--text-body-sm); color:var(--accent-primary); font-weight:700;"><span style="width:8px; height:8px; border-radius:999px; background:var(--accent-primary); display:inline-block; animation:pulse 2s infinite;"></span>the calendar</span>
      <h1 style="font-family: Aileron; font-weight: 700; letter-spacing: -0.01em; text-transform: lowercase; line-height: 0.96; font-size: clamp(2.8rem,8vw,var(--text-display-lg)); margin: var(--space-3) 0 0;">upcoming jams</h1>
      <p style="font-size:var(--text-body-lg); line-height:1.6; color:var(--text-secondary); max-width:56ch; margin-top:var(--space-5);">every jam is free and open to any young person who wants to play, watch, or just hang. show up, bring a friend, no experience needed.</p>
    </section>

    <section style="width:100%; max-width:var(--container-max); margin-inline:auto; padding-inline:var(--space-5); padding-bottom:var(--space-9);">
      {events.length === 0 ? (
        <p style="color:var(--text-secondary); font-size:var(--text-body-lg);">no jams on the calendar right now — follow us on instagram to hear about the next one first.</p>
      ) : (
        <div style="display:flex; flex-direction:column; gap:var(--space-5);">
          {events.map((e) => <EventCard {...e.data} />)}
        </div>
      )}

      <div style="margin-top:var(--space-7); background:var(--surface-sunken); border-radius:20px; padding:var(--space-7); display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:var(--space-5);">
        <div style="max-width:44ch; display:flex; flex-direction:column; gap:8px;">
          <h3 style="font-family: Aileron; font-weight: 700; text-transform: lowercase; font-size: var(--text-heading-lg); margin: 0;">never miss a jam</h3>
          <p style="margin:0; color:var(--text-secondary); font-size:var(--text-body-md);">we drop new dates on instagram first. follow along and we'll see you in the pit.</p>
        </div>
        <a href="https://www.instagram.com/amplifyforyouth/" target="_blank" rel="noopener" class="btn-coral" style="display:inline-flex; align-items:center; justify-content:center; gap:8px; font-family:var(--font-display); text-transform:uppercase; letter-spacing:0.06em; font-weight:600; font-size:15px; padding:14px 30px; border-radius:999px; background:var(--accent-primary); color:#fff; white-space:nowrap;">follow @amplifyforyouth</a>
      </div>
    </section>
  </main>
</Base>
