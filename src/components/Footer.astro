---
const year = new Date().getFullYear();
---

<footer style="background:var(--surface-page); color:var(--text-primary); padding-block:var(--space-8) var(--space-6); border-top:1.5px solid var(--border-default);">
  <div style="width:100%; max-width:var(--container-max); margin-inline:auto; padding-inline:var(--space-5);">
    <div style="display:grid; grid-template-columns:1.6fr 1fr 1fr; gap:var(--space-6);">
      <div>
        <img src="/assets/logos/amplify-logo-color-trim.png" alt="Amplify" style="height:60px; width:auto; margin-bottom:var(--space-4);" />
        <p style="color:var(--text-secondary); font-size:var(--text-body-sm); max-width:34ch;">a youth movement bringing young people together through music. you don't have to be the best to belong.</p>
      </div>
      <div>
        <h4 style="font-family:var(--font-display); font-weight:700; text-transform:uppercase; font-size:var(--text-heading-sm); margin:0 0 var(--space-4);">explore</h4>
        <ul style="list-style:none; margin:0; padding:0;">
          <li style="margin-bottom:10px;"><a href="/what-we-do" class="footer-link" style="font-size:var(--text-body-sm);">what we do</a></li>
          <li style="margin-bottom:10px;"><a href="/upcoming-jams" class="footer-link" style="font-size:var(--text-body-sm);">upcoming jams</a></li>
          <li style="margin-bottom:10px;"><a href="/moments" class="footer-link" style="font-size:var(--text-body-sm);">moments</a></li>
        </ul>
      </div>
      <div>
        <h4 style="font-family:var(--font-display); font-weight:700; text-transform:uppercase; font-size:var(--text-heading-sm); margin:0 0 var(--space-4);">say hi</h4>
        <ul style="list-style:none; margin:0; padding:0;">
          <li style="margin-bottom:10px;"><a href="https://www.instagram.com/amplifyforyouth/" target="_blank" rel="noopener" class="footer-link" style="font-size:var(--text-body-sm);">instagram</a></li>
          <li style="margin-bottom:10px;"><a href="https://www.tiktok.com/@amplifyforyouth" target="_blank" rel="noopener" class="footer-link" style="font-size:var(--text-body-sm);">tiktok</a></li>
        </ul>
      </div>
    </div>
    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:var(--space-8); padding-top:var(--space-5); border-top:1.5px solid var(--border-default); color:var(--text-secondary); font-size:var(--text-body-sm); flex-wrap:wrap; gap:var(--space-3);">
      <span>© {year} amplify · made in singapore, for the passion.</span>
    </div>
  </div>
</footer>
