---
interface Props {
  title: string;
  tag: string;
  date: Date;
  timeLabel: string;
  venue: string;
  rsvpUrl?: string;
}
const { title, tag, date, timeLabel, venue, rsvpUrl = '/rsvp' } = Astro.props;

const month = date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const day = String(date.getUTCDate()).padStart(2, '0');
const weekday = date.toLocaleDateString('en-US', { weekday: 'short', timeZone: 'UTC' }).toLowerCase();
const meta = `${weekday} · ${timeLabel} · ${venue}`;
---

<div style="display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:var(--space-6); background:var(--surface-raised); border:1.5px solid var(--border-default); border-radius:20px; padding:var(--space-5) var(--space-6); box-shadow:var(--shadow-soft);">
  <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; width:96px; height:96px; border-radius:16px; background:var(--wc-coral); color:#fff;">
    <span style="font-family:var(--font-display); text-transform:uppercase; font-size:var(--text-body-sm); letter-spacing:0.08em; opacity:.9;">{month}</span>
    <span style="font-family:var(--font-display); font-weight:700; font-size:40px; line-height:1;">{day}</span>
  </div>
  <div style="min-width:0;">
    <span style="display:inline-block; font-family:var(--font-display); text-transform:uppercase; letter-spacing:0.06em; font-size:var(--text-caption); font-weight:700; color:var(--wc-coral); border:1.5px solid var(--wc-coral); border-radius:999px; padding:3px 12px; margin-bottom:10px;">{tag}</span>
    <h3 style="font-family:var(--font-body); font-weight:900; font-size:var(--text-heading-md); margin:0 0 6px; text-transform:lowercase; letter-spacing:-0.01em;">{title}</h3>
    <p style="margin:0; color:var(--text-secondary); font-size:var(--text-body-md);">{meta}</p>
  </div>
  <a href={rsvpUrl} class="btn-dark" style="justify-self:end; display:inline-flex; align-items:center; justify-content:center; gap:8px; font-family:var(--font-display); text-transform:uppercase; letter-spacing:0.06em; font-weight:600; font-size:15px; padding:13px 26px; border-radius:999px; background:var(--text-primary); color:#fff; white-space:nowrap;">rsvp →</a>
</div>
